#include <stdio.h>

int main() {
    int arr[100], n, i, pos, val;
    printf("Enter current number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter position (1-based index) to insert at: ");
    scanf("%d", &pos);
    printf("Enter value to insert: ");
    scanf("%d", &val);

    int idx = pos - 1;
    for (i = n; i > idx; i--) {
        arr[i] = arr[i - 1];
    }
    arr[idx] = val;
    n++;

    printf("Array after insertion: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}
