#include <stdio.h>

int main() {
    int arr[100], n, i;
    printf("Enter current number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    if (n > 0) {
        n--;
    }

    printf("Array after deleting last element: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}
