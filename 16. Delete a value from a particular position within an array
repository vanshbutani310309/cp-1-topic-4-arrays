#include <stdio.h>

int main() {
    int arr[100], n, i, pos;
    printf("Enter current number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter position (1-based) to delete from: ");
    scanf("%d", &pos);

    int idx = pos - 1;
    for (i = idx; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }
    n--;

    printf("Array after deletion: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}
