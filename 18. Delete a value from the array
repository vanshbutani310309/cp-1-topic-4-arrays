#include <stdio.h>

int main() {
    int arr[100], n, i, j, val, found = 0;
    printf("Enter current number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter value to delete: ");
    scanf("%d", &val);

    for (i = 0; i < n; i++) {
        if (arr[i] == val) {
            for (j = i; j < n - 1; j++) {
                arr[j] = arr[j + 1];
            }
            n--;
            found = 1;
            i--;
        }
    }

    if (!found) {
        printf("Value not found in the array.\n");
    } else {
        printf("Array after deletion: ");
        for (i = 0; i < n; i++) {
            printf("%d ", arr[i]);
        }
        printf("\n");
    }
    return 0;
}
